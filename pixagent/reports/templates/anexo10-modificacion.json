  {
   "id": "problema",
   "title": "Definición del problema o situación actual",
   "kind": "ai",
   "words": 250,
   "instructions": "Define y acota el problema a resolver, distinguiendo el problema de sus causas y de sus consecuencias (Anexo 10). Cita el asiento del cuaderno de obra si se indica."
  },
  {
   "id": "descripcion",
   "title": "Descripción detallada de la modificación propuesta",
   "kind": "ai",
   "words": 350,
   "instructions": "Especifica con claridad el cambio: qué, quién, cómo, cuándo y dónde. Lista partidas afectadas."
  },
  {
   "id": "razon",
   "title": "Razón por la que se solicita la modificación",
   "kind": "ai",
   "words": 300,
   "instructions": "Por qué se solicita, por qué este curso de acción y no otro alternativo, y qué sucedería si el cambio no se realiza. Menciona la evidencia adjunta. Recuerda (7.3.6) que solo procede si sirve al objetivo y metas de la inversión o por imprevistos no atribuibles a los participantes."
  },
  {
   "id": "impacto",
   "title": "Tipo de impacto de la modificación",
   "kind": "fields_table",
   "keys": [
    "imp_calidad",
    "imp_calidad_desc",
    "imp_costo",
    "imp_costo_desc",
    "imp_plazo",
    "imp_plazo_desc"
   ]
  },
  {
   "id": "planteadas",
   "title": "Modificaciones planteadas",
   "kind": "fields_table",
   "keys": [
    "partidas_nuevas",
    "precios_nuevos",
    "precio_pactado",
    "estudios_adicionales"
   ]
  },
  {
   "id": "sustento",
   "title": "Documentos de sustento",
   "kind": "checklist",
   "opciones": [
    "Adjunto",
    "No",
    "N/A"
   ],
   "items": [
    "Informe técnico de modificación",
    "Memoria de cálculos técnicos",
    "Copia del cuaderno de obra, con asiento de la consulta",
    "Planos propuestos",
    "Cotizaciones",
    "Presupuesto",
    "Estudios de ingeniería de detalle",
    "Certificación o previsión presupuestal (si aumenta el costo neto)",
    "Otros necesarios"
   ]
  },
  {
   "id": "deficiencia",
   "title": "Deficiencia, situación imprevisible o de fuerza mayor que originó la modificación",
   "kind": "ai",
   "words": 250,
   "instructions": "Detalla el origen: deficiencia del expediente técnico, situación imprevisible o fuerza mayor, con la evidencia."
  },
  {
   "id": "informacion",
   "title": "Información de la modificación",
   "kind": "fields_table",
   "keys": [
    "mod_importe",
    "mod_pct",
